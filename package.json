{
  "name": "@benjos/spices",
  "version": "2.0.1",
  "description": "Collection of TypeScript common constant files for personal projects",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "preversion": "npm run typecheck && (npm whoami || npm login)",
    "postversion": "git push --follow-tags && npm publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeBenjos/spices.git"
  },
  "keywords": [
    "constants",
    "typescript"
  ],
  "author": "benjos",
  "license": "ISC",
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "bugs": {
    "url": "https://github.com/LeBenjos/spices/issues"
  },
  "homepage": "https://github.com/LeBenjos/spices#readme"
}
